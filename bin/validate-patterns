#!/usr/bin/env ruby
# frozen_string_literal: true

# Validates Rails upgrade detection-pattern YAML files.
#
# Usage:
#   bin/validate-patterns                # validate every patterns file
#   bin/validate-patterns path/to/file   # validate a specific file (one or more)
#   bin/validate-patterns --self-test    # run built-in fixture assertions
#
# Checks: YAML parses, required keys, `kind:` enum, and every `pattern` /
# `exclude` / `unless_file_matches` (optional absence check) regex compiles, has no control characters (a single backslash in a
# YAML double-quoted string, like "\b", becomes a backspace, not a word
# boundary), and finishes in bounded time on long stress inputs (catastrophic
# backtracking). Every error ends with a `hint:` on how to fix it.
#
# Exits 0 if all files / assertions pass, 1 otherwise.

require "yaml"
require "tmpdir"

PATTERNS_DIR = File.expand_path("../rails-upgrade/detection-scripts/patterns", __dir__)
TOP_LEVEL_KEYS = %w[version description upgrade_findings].freeze
PATTERN_KEYS = %w[name kind pattern exclude search_paths explanation fix variable_name].freeze
PRIORITY_KEYS = %w[high_priority medium_priority low_priority].freeze
KIND_VALUES = %w[breaking deprecation migration optional].freeze
# Optional regex keys, skipped when absent or "". `unless_file_matches` makes
# scan_patterns.rb skip a file whose content matches it (the setting a
# file-marker pattern asks about is already there).
OPTIONAL_REGEX_KEYS = %w[exclude unless_file_matches].freeze

# Control characters YAML makes from a single-backslash escape in a
# double-quoted string, mapped to the regex escape the author meant.
CONTROL_CHARS = {
  "\b" => '\\\\b (word boundary)', "\e" => '\\\\e', "\a" => '\\\\a',
  "\f" => '\\\\f', "\v" => '\\\\v', "\0" => '\\\\0'
}.freeze
CONTROL_RE = /[\x00-\x08\x0b\x0c\x0e-\x1f\x7f]/

# Stress inputs for the bounded-time check: long runs of the shapes that made
# real patterns backtrack (interpolation inside a hash, nested braces,
# continuation lines), after a word taken from the pattern so a literal prefix
# does not let the engine skip the input.
STRESS_REPS = 400
STRESS_LIMIT = 0.5 # seconds per match

def stress_inputs(src)
  # Drop regex escapes first, or `\blink_to` yields the word "blink_to".
  words = src.gsub(/\\./, " ").scan(/[A-Za-z_]{3,}/).uniq.first(3)
  prefixes = [""] + words.map { |w| "#{w} x, " }
  openers = ["", "{", "(", "data: {"]
  bodies = ['#{a} #', "a ", ", ", "x,\n", "{ a: "]
  prefixes.product(openers, bodies).map { |p, o, b| p + o + (b * STRESS_REPS) }
end

# The start of the first stress input the regex cannot finish, or nil. Needs a
# Ruby with Regexp timeouts (3.2+); older Rubies skip the check.
def slow_input(src)
  return nil unless Regexp.respond_to?(:timeout)

  re = Regexp.new(src, timeout: STRESS_LIMIT)
  stress_inputs(src).each do |input|
    re.match?(input)
  rescue Regexp::TimeoutError
    return input[0, 40]
  end
  nil
end

SLOW_HINT = "hint: a repeated group has branches that can match the same text " \
            '(e.g. `(?:[^{}]|#?\{...\})*`, where `#` fits both); make them exclusive ' \
            '(`[^{}#]|#(?!\{)|#?\{...\}`) or bound the repetition'

def validate(path)
  errors = []
  doc =
    begin
      YAML.safe_load_file(path)
    rescue Psych::SyntaxError => e
      hint =
        if e.message.include?("unknown escape")
          'hint: double every regex backslash inside a double-quoted YAML string ("\\\\s", "\\\\b"), or single-quote the value'
        else
          "hint: check indentation and quoting on the reported line"
        end
      return ["YAML parse error: #{e.message}; #{hint}"]
    end

  return ["top level is not a Hash"] unless doc.is_a?(Hash)

  TOP_LEVEL_KEYS.each do |k|
    errors << "missing top-level key: #{k}; hint: copy the header of a sibling rails-*-patterns.yml" unless doc.key?(k)
  end

  findings = doc["upgrade_findings"]
  return errors unless findings.is_a?(Hash)

  findings.each do |priority, patterns|
    next unless PRIORITY_KEYS.include?(priority)
    next unless patterns.is_a?(Array)

    patterns.each_with_index do |entry, i|
      label = "#{priority}[#{i}]" + (entry.is_a?(Hash) && entry["name"] ? " (#{entry["name"]})" : "")

      unless entry.is_a?(Hash)
        errors << "#{label}: not a Hash"
        next
      end

      PATTERN_KEYS.each do |k|
        errors << "#{label}: missing key: #{k}; hint: add `#{k}:` (an empty exclude is \"\"), see CLAUDE.md \"Detection patterns\"" unless entry.key?(k)
      end

      if entry.key?("kind") && !KIND_VALUES.include?(entry["kind"])
        errors << "#{label}: invalid kind: #{entry["kind"].inspect} (allowed: #{KIND_VALUES.join(", ")}); " \
                  "hint: judge the change at this hop, see CLAUDE.md \"Assigning kind\""
      end

      %w[pattern exclude unless_file_matches].each do |key|
        val = entry[key]
        next if OPTIONAL_REGEX_KEYS.include?(key) && (val.nil? || val.to_s.empty?)
        next if val.nil?

        unless val.is_a?(String)
          errors << "#{label}: #{key} is #{val.class}, not a String; hint: quote the regex"
          next
        end

        begin
          Regexp.new(val)
        rescue RegexpError => e
          errors << "#{label}: #{key} regex does not compile: #{e.message}; " \
                    "hint: in a double-quoted YAML string a literal regex backslash is written twice (\"\\\\(\" for a paren); " \
                    "try it with: ruby -e 'p Regexp.new(ARGV[0])' '<regex>'"
          next
        end

        if (ch = val[CONTROL_RE])
          meant = CONTROL_CHARS.fetch(ch, "a doubled backslash")
          errors << "#{label}: #{key} contains control character #{ch.inspect}; " \
                    "hint: YAML turned a single-backslash escape into it, write #{meant} in the double-quoted string"
        end

        if (input = slow_input(val))
          errors << "#{label}: #{key} regex did not finish in #{STRESS_LIMIT}s on a long input starting #{input.inspect}; #{SLOW_HINT}"
        end
      end
    end
  end

  errors
end

def self_test
  base = {
    "version" => "test",
    "description" => "self-test fixture",
    "upgrade_findings" => {
      "high_priority" => [
        {
          "name" => "Test entry",
          "kind" => "breaking",
          "pattern" => "foo",
          "exclude" => "",
          "search_paths" => ["app/"],
          "explanation" => "test",
          "fix" => "test",
          "variable_name" => "TEST"
        }
      ]
    }
  }

  cases = []

  KIND_VALUES.each do |kind|
    doc = Marshal.load(Marshal.dump(base))
    doc["upgrade_findings"]["high_priority"][0]["kind"] = kind
    cases << { name: "valid kind=#{kind}", doc: doc, expect: :pass }
  end

  missing_top = Marshal.load(Marshal.dump(base))
  missing_top.delete("upgrade_findings")
  cases << { name: "missing upgrade_findings", doc: missing_top, expect: :fail, match: /missing top-level key: upgrade_findings/ }

  missing_kind = Marshal.load(Marshal.dump(base))
  missing_kind["upgrade_findings"]["high_priority"][0].delete("kind")
  cases << { name: "missing pattern key kind", doc: missing_kind, expect: :fail, match: /missing key: kind/ }

  bad_regex = Marshal.load(Marshal.dump(base))
  bad_regex["upgrade_findings"]["high_priority"][0]["pattern"] = "[unclosed"
  cases << { name: "broken regex", doc: bad_regex, expect: :fail, match: /pattern regex does not compile/ }

  bad_kind = Marshal.load(Marshal.dump(base))
  bad_kind["upgrade_findings"]["high_priority"][0]["kind"] = "bogus"
  cases << { name: "unknown kind value", doc: bad_kind, expect: :fail, match: /invalid kind: "bogus"/ }

  control = Marshal.load(Marshal.dump(base))
  control["upgrade_findings"]["high_priority"][0]["pattern"] = "\bfoo\b"
  cases << { name: "single-backslash \\b read as a backspace", doc: control, expect: :fail, match: /control character "\\b".*word boundary/ }

  absence = Marshal.load(Marshal.dump(base))
  absence["upgrade_findings"]["high_priority"][0]["unless_file_matches"] = "^[ \t]*config\.foo[ \t]*="
  cases << { name: "valid unless_file_matches", doc: absence, expect: :pass }

  bad_absence = Marshal.load(Marshal.dump(base))
  bad_absence["upgrade_findings"]["high_priority"][0]["unless_file_matches"] = "config\.foo("
  cases << { name: "broken unless_file_matches regex", doc: bad_absence, expect: :fail, match: /unless_file_matches regex does not compile/ }

  absence_control = Marshal.load(Marshal.dump(base))
  absence_control["upgrade_findings"]["high_priority"][0]["unless_file_matches"] = "\bfoo"
  cases << { name: "control character in unless_file_matches", doc: absence_control, expect: :fail, match: /unless_file_matches contains control character/ }

  if Regexp.respond_to?(:timeout)
    slow = Marshal.load(Marshal.dump(base))
    # A draft CONFIRM_OPTION regex: `#` fits both branches of the repeated
    # hash body, so a long run of `#{a} #` backtracks.
    slow["upgrade_findings"]["high_priority"][0]["pattern"] =
      '\blink_to\b(?:(?:\bdata:)\s*\{(?:[^{}]|#?\{[^{}]*\})*\}|(?!%>|(?:\bdata:)\s*\{)[^\n])*?' \
      '(?:(?<=[,({])[ \t]*\n(?:(?:\bdata:)\s*\{(?:[^{}]|#?\{[^{}]*\})*\}|(?!%>|(?:\bdata:)\s*\{)[^\n])*?){0,4}?(\bconfirm:)'
    cases << { name: "catastrophic backtracking", doc: slow, expect: :fail, match: /did not finish in .*hint: a repeated group/ }
  end

  passed = 0
  failed = []

  Dir.mktmpdir do |dir|
    cases.each_with_index do |c, i|
      path = File.join(dir, "fixture_#{i}.yml")
      File.write(path, c[:doc].to_yaml)
      errors = validate(path)

      ok =
        case c[:expect]
        when :pass then errors.empty?
        when :fail then errors.any? { |e| e =~ c[:match] }
        end

      if ok
        passed += 1
      else
        failed << { name: c[:name], expected: c[:expect], errors: errors }
      end
    end
  end

  total = cases.size
  if failed.empty?
    puts "OK   self-test (#{passed}/#{total} passed)"
    0
  else
    puts "FAIL self-test (#{passed}/#{total} passed)"
    failed.each do |f|
      puts "     - #{f[:name]} (expected #{f[:expected]}, got errors: #{f[:errors].inspect})"
    end
    1
  end
end

if ARGV.include?("--self-test")
  exit self_test
end

paths =
  if ARGV.empty?
    Dir.glob(File.join(PATTERNS_DIR, "*.yml")).reject { |p| p.end_with?(".expectations.yml") }.sort
  else
    ARGV
  end

if paths.empty?
  warn "No YAML files to validate"
  exit 1
end

failed = false
paths.each do |path|
  errors = validate(path)
  if errors.empty?
    puts "OK   #{path}"
  else
    failed = true
    puts "FAIL #{path}"
    errors.each { |e| puts "     - #{e}" }
  end
end

exit(failed ? 1 : 0)
